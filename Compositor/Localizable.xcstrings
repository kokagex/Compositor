        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲット補正"
          }
        }
      }
    },
    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲット補正: 画像上をドラッグしてそのカラーの彩度を変更します。Command を押しながらドラッグすると色相を変更します"
          }
        }
