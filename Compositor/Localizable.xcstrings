    "Drag a color in the picture. Nearby color families move together." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像内のカラーをドラッグします。近い色系統も一緒に動きます。"
          }
        }
      }
    },
    "Drag a divider to change which tones the neighboring sliders affect." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区切りをドラッグすると、隣り合うスライダーが影響する階調を変更できます。"
          }
        }
      }
    },
    "Drag a point. Click the curve to add one. Double-click a point to remove it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポイントをドラッグします。カーブをクリックすると追加、ポイントをダブルクリックすると削除します。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで長方形 · Shift で追加 · Option で削除 · ドラッグ中に再度 Shift で正方形 · 内側をドラッグで移動 · ⌘+ドラッグでピクセルを移動 · Delete で消去 · ⌘D で選択解除"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグでテキストボックス · テキストをクリックで編集 · ボックスのハンドルをドラッグでサイズ変更 · ⌘Return で確定 · Escape でキャンセル"
          }
        }
      }
    },
    "Drag an ellipse · Shift add · Option subtract · Shift again mid-drag circle · Drag inside to move · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで楕円 · Shift で追加 · Option で削除 · ドラッグ中に再度 Shift で正円 · 内側をドラッグで移動 · Delete で消去 · ⌘D で選択解除"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホイールの内側をドラッグします。角度で色相、中心からの距離で彩度を設定します。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイヤー上をドラッグしてガイドを配置します。2 本以上の線を描いてください。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像上をドラッグすると、ポインターの下の階調に対応するカーブを動かせます。"
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグまたはスクロールで移動。ダブルクリックで全体表示と 100% を切り替え"
          }
